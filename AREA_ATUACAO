class AreaAtuacaoRequest {
    constructor(slug, nome, descricao, ativo = true) {
        this.slug = slug;
        this.nome = nome;
        this.descricao = descricao;
        this.ativo = ativo;
    }
}

class AreaAtuacaoResponse {
    constructor(id, slug, nome, descricao, ativo, criadoEm, atualizadoEm) {
        this.id = id;
        this.slug = slug;
        this.nome = nome;
        this.descricao = descricao;
        this.ativo = ativo;
        this.criadoEm = criadoEm;
        this.atualizadoEm = atualizadoEm;
    }
}

module.exports = {
    AreaAtuacaoRequest,
    AreaAtuacaoResponse
};
